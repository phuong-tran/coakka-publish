<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- This module was also published with a richer model, Gradle metadata,  -->
  <!-- which should be used instead. Do not delete the following line which  -->
  <!-- is to indicate to Gradle or any Gradle module metadata file consumer  -->
  <!-- that they should prefer consuming it instead. -->
  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.phuong-tran.coakka</groupId>
  <artifactId>runtime</artifactId>
  <version>2.5.3</version>
  <name>coakka.runtime</name>
  <description>Java 8-compatible JVM connector with packaged native runtimes for CoAkka Runtime v2.</description>
  <url>https://github.com/phuong-tran/coakka-publish</url>
  <inceptionYear>2025</inceptionYear>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://github.com/phuong-tran/coakka-samples/blob/main/LICENSE</url>
      <distribution>repo</distribution>
      <comments>Applies to the language-level JVM connector material.</comments>
    </license>
    <license>
      <name>CoAkka Native Artifact License 1.2</name>
      <url>https://github.com/phuong-tran/coakka-samples/blob/main/NATIVE-LICENSE.md</url>
      <distribution>repo</distribution>
      <comments>Applies to bundled CoAkka native artifacts; see META-INF/PACKAGE-LICENSE.md.</comments>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>phuong-tran</id>
      <name>Phuong Tran</name>
      <email>gabrielgun1983@gmail.com</email>
      <url>https://github.com/phuong-tran</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/phuong-tran/coakka-samples.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/phuong-tran/coakka-samples.git</developerConnection>
    <tag>runtime-jvm-2.5.3</tag>
    <url>https://github.com/phuong-tran/coakka-samples/tree/runtime-jvm-2.5.3/source-mirrors/runtime-jvm/2.5.3</url>
  </scm>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-stdlib</artifactId>
        <version>2.3.10</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-coroutines-core-jvm</artifactId>
      <version>1.10.2</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna</artifactId>
      <version>5.17.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>4.31.1</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-coroutines-jdk8</artifactId>
      <version>1.10.2</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-serialization-json-jvm</artifactId>
      <version>1.7.3</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
  <properties>
    <coakka.documentation.url>https://github.com/phuong-tran/coakka-samples/tree/main/docs</coakka.documentation.url>
    <coakka.samples.url>https://github.com/phuong-tran/coakka-samples</coakka.samples.url>
    <coakka.source.url>https://github.com/phuong-tran/coakka-samples/tree/runtime-jvm-2.5.3/source-mirrors/runtime-jvm/2.5.3</coakka.source.url>
  </properties>
</project>
